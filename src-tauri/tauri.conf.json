{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tcp-kai",
  "version": "1.4.0",
  "identifier": "com.kaidstor.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "visible": false,
        "height": 600,
        "resizable": true,
        "title": "",
        "titleBarStyle": "Overlay",
        "width": 1000
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Anton Lobanov (4SR685J3M9)",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:app.db"
      ]
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NUE2OUQxQzcwMzFBMTQKUldRVUdnUEgwV2xhOWw2MmxOOXJpTSs2SlB1aS9QZzZQZllpSWFkM0hJWWdDRlhtNlpLRzRnNVoK",
      "endpoints": [
        "https://github.com/Kaidstor/tcp-kai/releases/latest/download/latest.json",
        "https://gitlab.com/kaidstor/tcp_client_tauri/-/releases/permalink/latest/downloads/latest.json"
      ]
    }
  }
}
