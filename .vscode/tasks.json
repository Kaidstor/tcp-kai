{  
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Release",
      "type": "shell",
            "command": "bunx",
      "args": [
        "dotenv",
        "-e",
        ".env",
        "--",
        "./release.sh",
        "${input:releaseVersion}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },

  ],
      "inputs": [
        {
          "id": "releaseVersion",
          "type": "promptString",
          "description": "Enter new version (leave empty to bump patch)",
          "default": ""
        }
      ],
}
